{"id":"b754788559","from":0,"units":["CREATE TABLE t1 (A INT, B INT);\nCREATE TABLE t2 (A INT, C INT);\n\nINSERT INTO t1 VALUES(1, 10);\nINSERT INTO t1 VALUES(1, 20);\nINSERT INTO t1 VALUES(1, 30);\nSELECT * FROM t1;\n----------\n| A | B |\n----------\n| 1 | 10 |\n| 1 | 20 |\n| 1 | 30 |\n----------\n\nINSERT INTO t2 VALUES(1, 110);\nINSERT INTO t2 VALUES(1, 220);\nINSERT INTO t2 VALUES(1, 330);\nSELECT * FROM t2;\n-----------\n| A | C |\n-----------\n| 1 | 110 |\n| 1 | 220 |\n| 1 | 330 |\n-----------\n\nSELECT * FROM t1 CROSS JOIN t2;\nSELECT * FROM t1 INNER JOIN t2;\nSELECT * FROM t1 JOIN t2;\n--------------------\n| A | B | A | C |\n--------------------\n| 1 | 30 | 1 | 110 |\n| 1 | 20 | 1 | 110 |\n| 1 | 10 | 1 | 110 |\n| 1 | 30 | 1 | 220 |\n| 1 | 20 | 1 | 220 |\n| 1 | 10 | 1 | 220 |\n| 1 | 30 | 1 | 330 |\n| 1 | 20 | 1 | 330 |\n| 1 | 10 | 1 | 330 |\n--------------------\nSELECT * FROM t1 NATURAL JOIN t2;\n----------------\n| A | B | C |\n----------------\n| 1 | 30 | 110 |\n| 1 | 20 | 110 |\n| 1 | 10 | 110 |\n| 1 | 30 | 220 |\n| 1 | 20 | 220 |\n| 1 | 10 | 220 |\n| 1 | 30 | 330 |\n| 1 | 20 | 330 |\n| 1 | 10 | 330 |\n----------------\n****************************************************************************************\n****************************************************************************************\nINSERT INTO t1 VALUES(1, 10);\nINSERT INTO t1 VALUES(2, 20);\nINSERT INTO t1 VALUES(3, 30);\nSELECT * FROM t1;\n----------\n| A | B |\n----------\n| 1 | 10 |\n| 2 | 20 |\n| 3 | 30 |\n----------\n\nINSERT INTO t2 VALUES(4, 40);\nINSERT INTO t2 VALUES(5, 50);\nINSERT INTO t2 VALUES(6, 60);\nSELECT * FROM t2;\n----------\n| A | C |\n----------\n| 4 | 40 |\n| 5 | 50 |\n| 6 | 60 |\n----------\n\nSELECT * FROM t1 CROSS JOIN t2;\nSELECT * FROM t1 INNER JOIN t2;\nSELECT * FROM t1 JOIN t2;\n-------------------\n| A | B | A | C |\n-------------------\n| 3 | 30 | 4 | 40 |\n| 2 | 20 | 4 | 40 |\n| 1 | 10 | 4 | 40 |\n| 3 | 30 | 5 | 50 |\n| 2 | 20 | 5 | 50 |\n| 1 | 10 | 5 | 50 |\n| 3 | 30 | 6 | 60 |\n| 2 | 20 | 6 | 60 |\n| 1 | 10 | 6 | 60 |\n-------------------\nSELECT * FROM t1 NATURAL JOIN t2;\nNothing"]}